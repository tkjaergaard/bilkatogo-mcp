{
  "name": "bilka-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Unofficial, private MCP server for BilkaToGo (proof of concept)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "node src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc",
    "lint": "oxlint --deny-warnings",
