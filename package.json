{
  "name": "bilkatogo-mcp",
  "version": "0.2.1",
  "description": "Unofficial, private MCP server for BilkaToGo (proof of concept)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tkjaergaard/bilkatogo-mcp.git"
  },
  "bin": {
    "bilkatogo-mcp": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "start": "node src/main.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "deadcode": "fallow dead-code",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run deadcode && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^26.6.6",
    "fallow": "3.38.1",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  }
}
